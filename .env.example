# Copier vers .env : cp .env.example .env
DATABASE_URL="file:./dev.db"
# Obligatoire en production (>= 16 caractères). Générer : openssl rand -base64 32
AUTH_SECRET="change-me-with-a-long-random-string"
APP_URL="http://localhost:3000"
MAIL_FROM="Travel's Affair <no-reply@travels-affair.com>"
# Adresse qui reçoit les messages du formulaire de contact
CONTACT_TO=""
# Dossier des photos téléversées (monter un volume persistant en production)
UPLOAD_DIR="./data/uploads"

# SMTP : si SMTP_HOST est absent, les e-mails sont seulement journalisés (admin > E-mails)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Tâche planifiée (toutes les 5 min) : GET /api/cron/reminders avec Authorization: Bearer <CRON_SECRET>
# Préremplit la page de connexion avec les comptes de démo (mettre false en production !)
DEMO_LOGIN="true"
CRON_SECRET="change-me-cron"
# Rappels avant départ, en minutes (séparées par des virgules) : 1 jour et 30 minutes
REMINDER_MINUTES="1440,30"
PENDING_PAYMENT_TTL_MINUTES=30

# --- Paiements réels : renseigner les clés fournies par l'agence. Sans clés => mode démonstration. ---
# Cartes Visa / Mastercard (Stripe Checkout)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...      (endpoint : APP_URL/api/webhooks/stripe)
# PayPal
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=live                      (ou sandbox)
# Orange Money / MTN MoMo via l'agrégateur Campay
# CAMPAY_USERNAME=
# CAMPAY_PASSWORD=
# CAMPAY_BASE_URL=https://demo.campay.net   (production : https://www.campay.net)

# CinetPay (Orange Money, MTN MoMo, Express Union, cartes… — checkout hébergé ; remplace Campay/Stripe pour ces moyens)
# CINETPAY_APIKEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=                 (optionnel, vérification du token du webhook)
# endpoint de notification : APP_URL/api/webhooks/cinetpay
